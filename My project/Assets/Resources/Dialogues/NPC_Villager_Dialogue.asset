  - speakerName: "\uB300\uC7A5\uC7A5\uC774"
    dialogueText: "\uAD34\uC218\uAC00 \uB0B4 \uC758\uC548\uC744 \uAC00\uC9C0\uACE0
      \uB9C8\uC744 \uBC16\uC73C\uB85C \uB3C4\uB9DD\uAC14\uC5B4."
    target: 1
  - speakerName: "\uB300\uC7A5\uC7A5\uC774"
    dialogueText: "\uADF8 \uB188\uB4E4\uC744 \uCC3E\uC544\uC11C \uD63C\uB0B4\uC918."
